# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay — Dashboard > Settings > API Keys (use Test Mode keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard > Settings > Webhooks — set when creating the webhook endpoint
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Base URL of this app (used when configuring the Razorpay webhook endpoint)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — used only by scripts/seed-admin.mjs. Defaults to
# admin@trusta.com / admin@123 if left unset.
SEED_ADMIN_EMAIL=admin@trusta.com
SEED_ADMIN_PASSWORD=admin@123
